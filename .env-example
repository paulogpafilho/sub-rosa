# Copy to .env in the repository root.
# Plain KEY=value syntax is shared by Compose and Spring's properties importer.
# Use a random hex password; avoid quotes and $ / backslash interpolation.

# Mandatory for Compose; optional for direct Java startup; no code default.
DB_NAME=subrosa
# Mandatory; used by PostgreSQL and the IdP; no code default.
DB_USER=subrosa
# Mandatory secret; no code default. Replace this sample before startup.
DB_PASSWORD=replace-with-a-random-64-character-hex-password
# Mandatory for Compose; optional for direct Java startup; no code default.
DB_PORT=5432
# Mandatory; no code default. Container hostname for Compose.
# Direct Java startup: use a reachable database hostname instead of postgres.
IDP_DB_URL=jdbc:postgresql://postgres:5432/subrosa
# Optional in code (default 9000); mandatory for Compose to keep ports consistent.
IDP_PORT=9000
# Mandatory; no code default. Must match public hostname and published port.
IDP_ISSUER=http://idp.localtest.me:9000
# Mandatory for Compose alias; optional for direct Java startup; no code default.
IDP_HOSTNAME=idp.localtest.me
# Optional in code (default: no active profile, HTTPS required, secure cookies).
# Mandatory for Compose. dev permits HTTP and disables Secure on session cookies.
SPRING_PROFILES_ACTIVE=dev

# Mandatory on every startup; no default. AES-256 key encoded as exactly 64 hex
# characters (32 cryptographically random bytes). Replace the placeholder.
# Back up securely with the database; losing/changing it prevents key recovery.
IDP_KEY_ENCRYPTION_SECRET=replace-with-64-random-hex-characters

# Required only when the users table is empty; no usable code defaults.
# Bootstrap creates one enabled account and never replaces existing users.
IDP_ADMIN_USER=admin
IDP_ADMIN_PASSWORD=replace-with-a-random-64-character-hex-password
# Optional; code default 12; supported range 10..16.
IDP_BCRYPT_COST=12
# Optional; code default 72 UTF-8 bytes; supported range 1..72.
IDP_PASSWORD_MAX_BYTES=72
# Optional; code defaults 5 consecutive failures and a 15-minute account lock.
IDP_LOCKOUT_FAILURES=5
IDP_LOCKOUT_DURATION=15m
# Optional; code defaults 20 login attempts per socket IP in a sliding minute.
IDP_IP_ATTEMPTS=20
IDP_IP_WINDOW=1m
# Optional; code default 10000 active IPs; rejects new IPs at capacity.
IDP_IP_CAPACITY=10000
# Optional; code defaults 30 minutes idle and 8 hours absolute since login.
# Durations must be positive whole seconds (s, m, h or ISO-8601).
IDP_SESSION_IDLE_TIMEOUT=30m
IDP_SESSION_ABSOLUTE_TIMEOUT=8h
